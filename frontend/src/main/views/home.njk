{% extends "template.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">Caseworker Task Manager</h1>

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
              <p>{{ error }}</p>
            </div>
          </div>
        </div>
      {% endif %}

      <a href="/tasks/new" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
        Create new task
      </a>

      {% if tasks.length === 0 %}
        <p class="govuk-body">No tasks found. Create one to get started.</p>
      {% else %}
        <table class="govuk-table">
          <caption class="govuk-table__caption govuk-table__caption--m">All tasks</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Title</th>
              <th scope="col" class="govuk-table__header">Status</th>
              <th scope="col" class="govuk-table__header">Due date</th>
              <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for task in tasks %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ task.title }}</td>
                <td class="govuk-table__cell">
                  {% if task.status === "TODO" %}
                    <strong class="govuk-tag govuk-tag--grey">To do</strong>
                  {% elif task.status === "IN_PROGRESS" %}
                    <strong class="govuk-tag govuk-tag--blue">In progress</strong>
                  {% elif task.status === "DONE" %}
                    <strong class="govuk-tag govuk-tag--green">Done</strong>
                  {% endif %}
                </td>
                <td class="govuk-table__cell">{{ task.dueDateTime | replace("T", " ") | truncate(16, true, "") }}</td>
                <td class="govuk-table__cell">
                  <a href="/tasks/{{ task.id }}" class="govuk-link">View</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>
{% endblock %}
